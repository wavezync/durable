---
// An illustration of durable_dashboard. The sidebar switches views (and they
// cycle on their own until someone clicks). Example data, real page structure.
import { LayoutDashboard, ListTree, Workflow, Inbox, Layers, CalendarClock, ChartLine, Search, RotateCcw, Ban, Pause, Play } from '@lucide/astro';

const nav = [
  { view: null, icon: LayoutDashboard, label: 'Overview' },
  { view: 'runs', icon: ListTree, label: 'Runs' },
  { view: null, icon: Workflow, label: 'Workflows' },
  { view: 'inbox', icon: Inbox, label: 'Inbox', badge: 3 },
  { view: 'queues', icon: Layers, label: 'Queues' },
  { view: null, icon: CalendarClock, label: 'Schedules' },
  { view: null, icon: ChartLine, label: 'Telemetry' },
];
const runs = [
  { s: 'running', wf: 'issue_agent', id: 'a91c3e', d: '12s', at: 'now' },
  { s: 'failed', wf: 'process_order', id: '8f3c2a', d: '1.4s', at: '2m ago' },
  { s: 'waiting', wf: 'expense_approval', id: '4b07d1', d: '2d 3h', at: '2d ago' },
  { s: 'completed', wf: 'process_order', id: '77e0b9', d: '2.1s', at: '5m ago' },
  { s: 'compensated', wf: 'book_trip', id: 'c2d4a0', d: '3.8s', at: '9m ago' },
  { s: 'completed', wf: 'daily_sales_report', id: '1fa9e2', d: '41s', at: '9:00' },
];
const label: Record<string, string> = { running: 'Running', failed: 'Failed', waiting: 'Waiting', completed: 'Completed', compensated: 'Compensated' };
const trace = [
  { s: 'completed', name: 'validate', at: 0, w: 6, d: '12ms' },
  { s: 'failed', name: 'charge #1', at: 7, w: 22, d: '1.1s' },
  { s: 'failed', name: 'charge #2', at: 40, w: 18, d: '0.9s' },
  { s: 'failed', name: 'charge #3', at: 74, w: 20, d: '1.0s' },
  { s: 'pending', name: 'send_confirmation', at: 0, w: 0, d: 'not run' },
];
const queues = [
  { name: 'default', conc: 10, busy: 7, backlog: 23, bars: [4, 6, 5, 8, 7, 9, 6, 8, 10, 9, 7, 8] },
  { name: 'priority', conc: 5, busy: 2, backlog: 0, bars: [1, 2, 1, 3, 2, 1, 2, 2, 1, 2, 3, 2] },
  { name: 'emails', conc: 20, busy: 0, backlog: 412, paused: true, bars: [3, 5, 8, 11, 14, 18, 21, 25, 30, 34, 38, 42] },
];
---
<div class="dash" data-dash>
  <div class="top">
    <i></i><i></i><i></i>
    <span class="url">localhost:4000/dashboard</span>
    <span class="search"><Search size={14} />Search runs and workflows<kbd>⌘K</kbd></span>
  </div>
  <div class="body">
    <nav class="side" aria-label="Dashboard views">
      <span class="brand"><img src="/favicon.svg" width="18" height="18" alt="" />Durable</span>
      {nav.map((n) => (
        n.view ? (
          <button type="button" class="item" data-view={n.view} aria-pressed={n.view === 'runs' ? 'true' : 'false'}>
            <n.icon size={16} />{n.label}{n.badge && <b class="badge">{n.badge}</b>}
          </button>
        ) : (
          <span class="item off"><n.icon size={16} />{n.label}</span>
        )
      ))}
    </nav>

    <div class="main">
      <section class="view on" data-pane="runs" aria-label="Runs">
        <div class="query"><span class="chip">status: <b>any</b></span><span class="chip">last <b>1h</b></span><span class="q">Filter by workflow, status or run id</span></div>
        <table>
          <thead><tr><th>Status</th><th>Workflow</th><th>Run</th><th>Took</th><th>Started</th></tr></thead>
          <tbody>
            {runs.map((r) => (
              <tr class:list={[{ hl: r.id === '8f3c2a' }]}>
                <td><span class:list={['pill', r.s]}><i></i>{label[r.s]}</span></td>
                <td><code>{r.wf}</code></td><td><code class="dim">{r.id}</code></td><td>{r.d}</td><td class="dim">{r.at}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>

      <section class="view" data-pane="trace" aria-label="Run trace">
        <div class="trace-head">
          <div><code>process_order</code> <code class="dim">run 8f3c2a</code> <span class="pill failed"><i></i>Failed</span></div>
          <div class="acts"><span class="btn-x primary"><RotateCcw size={14} />Retry from charge</span><span class="btn-x"><Ban size={14} />Cancel</span></div>
        </div>
        <div class="water">
          {trace.map((t) => (
            <div class:list={['wrow', t.s]}>
              <span class="nm"><i></i><code>{t.name}</code></span>
              <span class="lane">{t.w > 0 && <b style={`left: ${t.at}%; width: ${t.w}%`} />}</span>
              <span class="dur">{t.d}</span>
            </div>
          ))}
        </div>
        <div class="err">
          <span class="dim">Error on attempt 3</span>
          <code>{"(MatchError) no match of right hand side value: {:error, :card_declined}"}</code>
          <code class="dim">(my_app 0.1.0) lib/my_app/orders.ex:28: MyApp.OrderWorkflow.charge/1</code>
        </div>
      </section>

      <section class="view" data-pane="inbox" aria-label="Inbox">
        {[
          ['expense_approval', 'Approve the $420 expense from Dana?', 'manager', '2h'],
          ['issue_agent', 'Review the patch for acme/shop#1042', 'maintainer', '1d'],
          ['refund_request', 'Refund or store credit?', 'support', '3d'],
        ].map(([wf, prompt, who, age]) => (
          <div class="ask">
            <div><code>{wf}</code><p>{prompt}</p><span class="dim">waiting for {who}, {age}</span></div>
            <div class="acts"><span class="btn-x primary">Approve</span><span class="btn-x">Reject</span></div>
          </div>
        ))}
      </section>

      <section class="view" data-pane="queues" aria-label="Queues">
        {queues.map((q) => (
          <div class="queue">
            <div class="qhead">
              <code>{q.name}</code>
              {q.paused ? <span class="pill waiting"><i></i>Paused</span> : <span class="pill running"><i></i>{q.busy} of {q.conc} busy</span>}
              <span class="btn-x small">{q.paused ? <><Play size={13} />Resume</> : <><Pause size={13} />Pause</>}</span>
            </div>
            <div class="spark" aria-hidden="true">{q.bars.map((h) => <i style={`height: ${(h / 42) * 100}%`} />)}</div>
            <span class="dim">{q.backlog} waiting</span>
          </div>
        ))}
      </section>
    </div>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-dash]')) {
    const items = [...root.querySelectorAll<HTMLButtonElement>('.item[data-view]')];
    const panes = [...root.querySelectorAll<HTMLElement>('.view')];
    const ORDER = ['runs', 'trace', 'inbox', 'queues'];
    let auto = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0;
    let timer = 0;

    const show = (view: string) => {
      i = ORDER.indexOf(view);
      panes.forEach((p) => p.classList.toggle('on', p.dataset.pane === view));
      // The trace belongs to Runs in the sidebar.
      const navView = view === 'trace' ? 'runs' : view;
      items.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === navView)));
    };
    const cycle = () => {
      clearTimeout(timer);
      if (auto) timer = window.setTimeout(() => (show(ORDER[(i + 1) % ORDER.length]), cycle()), 4200);
    };

    items.forEach((b) =>
      b.addEventListener('click', () => {
        auto = false;
        clearTimeout(timer);
        show(b.dataset.view!);
      }),
    );
    root.querySelector('tr.hl')?.addEventListener('click', () => {
      auto = false;
      show('trace');
    });

    new IntersectionObserver(([e]) => (e.isIntersecting ? cycle() : clearTimeout(timer)), { threshold: 0.3 }).observe(root);
  }
</script>

<style>
  .dash {
    border-radius: 22px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.1);
    background: linear-gradient(180deg, rgba(19, 28, 48, 0.95), rgba(11, 18, 32, 0.95));
    box-shadow: 0 60px 160px -50px rgba(92, 144, 255, 0.45), 0 40px 120px -60px rgba(214, 166, 255, 0.45);
    font-size: 14px;
  }
  .top { display: flex; align-items: center; gap: 8px; height: 48px; padding: 0 18px; border-bottom: 1px solid var(--rule); }
  .top i { width: 11px; height: 11px; border-radius: 50%; background: rgba(255, 255, 255, 0.12); }
  .url { margin-left: 12px; font: 12.5px var(--sl-font-mono); color: var(--dim); }
  .search {
    margin-left: auto; display: inline-flex; align-items: center; gap: 8px; height: 30px; padding: 0 8px 0 12px; border-radius: 9px;
    border: 1px solid var(--rule); color: var(--dim); font-size: 13px;
  }
  kbd { font: 11.5px var(--sl-font-mono); padding: 1px 6px; border-radius: 5px; border: 1px solid var(--rule); margin-left: 18px; }

  .body { display: grid; grid-template-columns: 196px minmax(0, 1fr); height: 430px; }
  .side { display: flex; flex-direction: column; gap: 2px; padding: 14px 10px; border-right: 1px solid var(--rule); background: rgba(11, 16, 27, 0.45); }
  .brand { display: flex; align-items: center; gap: 8px; padding: 4px 10px 14px; font-weight: 600; font-size: 14px; }
  .item {
    display: flex; align-items: center; gap: 10px; height: 34px; padding: 0 10px; border-radius: 9px; border: 0; background: none;
    color: var(--mist); font: inherit; font-size: 13.5px; text-align: left; cursor: pointer; transition: background 0.2s, color 0.2s;
  }
  .item.off { cursor: default; opacity: 0.55; }
  button.item:hover { background: rgba(255, 255, 255, 0.04); color: var(--ink); }
  .item[aria-pressed='true'] { background: rgba(255, 194, 122, 0.1); color: var(--ink); box-shadow: inset 2px 0 var(--amber); }
  .item :global(svg) { color: inherit; flex: none; }
  .badge { margin-left: auto; min-width: 20px; height: 18px; display: grid; place-items: center; border-radius: 9px; background: var(--rose); color: #1d0c14; font-size: 11px; }

  .main { position: relative; overflow: hidden; }
  .view { position: absolute; inset: 0; padding: 18px 22px; overflow: hidden; opacity: 0; visibility: hidden; transform: translateY(8px); transition: opacity 0.35s, transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0.35s; }
  .view.on { opacity: 1; visibility: visible; transform: none; }
  code { font: 12.5px var(--sl-font-mono); color: var(--ink); }
  .dim { color: var(--dim); }

  .pill { --c: #8a929c; display: inline-flex; align-items: center; gap: 7px; padding: 3px 10px; border-radius: 999px; font-size: 12.5px; white-space: nowrap; background: color-mix(in srgb, var(--c) 15%, transparent); color: color-mix(in srgb, var(--c) 60%, #fff); }
  .pill i { width: 7px; height: 7px; border-radius: 50%; background: var(--c); }
  .running { --c: #7da6ff; }
  .failed { --c: #f0718a; }
  .failed i { border-radius: 1px; transform: rotate(45deg); }
  .waiting { --c: #ffc27a; }
  .waiting i { background: none; border: 2px solid var(--c); box-sizing: border-box; }
  .completed { --c: #2bb3a3; }
  .compensated { --c: #9ebcfd; }
  .pending { --c: #6b7380; }

  .query { display: flex; align-items: center; gap: 8px; height: 36px; padding: 0 10px; border-radius: 10px; border: 1px solid var(--rule); margin-bottom: 12px; font-size: 13px; }
  .chip { padding: 2px 9px; border-radius: 7px; background: rgba(255, 255, 255, 0.06); color: var(--mist); }
  .chip b { color: var(--ink); font-weight: 500; }
  .q { color: var(--dim); }
  table { width: 100%; border-collapse: collapse; }
  th { text-align: left; font-weight: 500; font-size: 12.5px; color: var(--dim); padding: 6px 8px; border-bottom: 1px solid var(--rule); }
  td { padding: 9px 8px; border-bottom: 1px solid rgba(255, 255, 255, 0.05); white-space: nowrap; }
  tr.hl { background: rgba(240, 113, 138, 0.06); cursor: pointer; }

  .trace-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 16px; }
  .trace-head > div:first-child { display: flex; align-items: center; gap: 10px; }
  .acts { display: flex; gap: 8px; }
  .btn-x { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px; border-radius: 9px; border: 1px solid var(--rule); color: var(--ink); font-size: 13px; white-space: nowrap; }
  .btn-x.primary { background: var(--cream); color: var(--night); border-color: var(--cream); font-weight: 600; }
  .btn-x.small { height: 26px; padding: 0 10px; font-size: 12.5px; margin-left: auto; }
  .water { display: flex; flex-direction: column; gap: 4px; }
  .wrow { --c: #6b7380; display: grid; grid-template-columns: 170px minmax(0, 1fr) 64px; align-items: center; gap: 12px; height: 32px; }
  .wrow.completed { --c: #2bb3a3; }
  .wrow.failed { --c: #f0718a; }
  .nm { display: flex; align-items: center; gap: 8px; }
  .nm i { width: 7px; height: 7px; border-radius: 50%; background: var(--c); }
  .wrow.failed .nm i { border-radius: 1px; transform: rotate(45deg); }
  .wrow.pending .nm i { background: none; border: 1.5px dashed var(--c); box-sizing: border-box; }
  .wrow.pending code { color: var(--dim); }
  .lane { position: relative; height: 10px; border-radius: 3px; background: rgba(255, 255, 255, 0.04); }
  .lane b { position: absolute; top: 0; bottom: 0; border-radius: 3px; background: var(--c); }
  .view.on .lane b { animation: grow 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) both; transform-origin: left; }
  @keyframes grow { from { transform: scaleX(0); } }
  .dur { text-align: right; font: 12px var(--sl-font-mono); color: var(--dim); }
  .err { margin-top: 18px; padding: 12px 14px; border-radius: 12px; border: 1px solid rgba(240, 113, 138, 0.3); background: rgba(240, 113, 138, 0.06); display: flex; flex-direction: column; gap: 4px; font-size: 13px; }
  .err code { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .ask { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 14px 16px; border-radius: 14px; border: 1px solid var(--rule); margin-bottom: 10px; background: rgba(255, 255, 255, 0.02); }
  .ask p { margin: 4px 0 2px; font-size: 14.5px; }
  .ask .dim { font-size: 12.5px; }

  .queue { display: grid; grid-template-columns: minmax(0, 1fr) 180px; grid-template-rows: auto auto; gap: 6px 20px; align-items: end; padding: 14px 16px; border-radius: 14px; border: 1px solid var(--rule); margin-bottom: 10px; }
  .qhead { display: flex; align-items: center; gap: 10px; }
  .spark { grid-row: span 2; display: flex; align-items: flex-end; gap: 3px; height: 44px; }
  .spark i { flex: 1; border-radius: 2px 2px 0 0; background: linear-gradient(180deg, var(--amber), rgba(214, 166, 255, 0.6)); }
  .view.on .spark i { animation: rise-bar 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both; transform-origin: bottom; }
  @keyframes rise-bar { from { transform: scaleY(0); } }
  .queue > .dim { font-size: 12.5px; }

  @media (max-width: 760px) {
    .body { grid-template-columns: minmax(0, 1fr); height: 470px; }
    .side { flex-direction: row; overflow-x: auto; border-right: 0; border-bottom: 1px solid var(--rule); padding: 8px; }
    .brand, .item.off { display: none; }
    .search, .url { display: none; }
    th:nth-child(n + 4), td:nth-child(n + 4) { display: none; }
    .wrow { grid-template-columns: 120px minmax(0, 1fr) 54px; }
    .queue { grid-template-columns: minmax(0, 1fr) 100px; }
    .ask { flex-direction: column; align-items: flex-start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .view, .view.on .lane b, .view.on .spark i { transition: none; animation: none; }
  }
</style>
