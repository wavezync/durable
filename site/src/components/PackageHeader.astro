---
// Package facts under the page title: what the README's badges say, in the site's
// own look. Values come from packageMeta() in docs.ts (mix.exs + shared.exs).
import { Icon } from '@astrojs/starlight/components';
import { Package, Scale, Droplet, BookOpen, Copy } from '@lucide/astro';

interface Props {
  name: string;
  version: string;
  elixir: string;
  license: string;
  dep: string;
  hex: string;
  hexdocs: string;
  github: string;
}
const { name, version, elixir, license, dep, hex, hexdocs, github } = Astro.props;
---
<div class="pkg not-content">
  <ul class="facts" aria-label={`${name} at a glance`}>
    <li><Package size={14} /><span>v{version}</span></li>
    <li><Droplet size={14} /><span>Elixir {elixir}</span></li>
    <li><Scale size={14} /><span>{license} license</span></li>
  </ul>
  <div class="row">
    <button class="dep" type="button" data-copy={dep}>
      <code>{dep}</code>
      <span class="copy"><Copy size={14} /><span data-label>Copy</span></span>
    </button>
    <nav class="links" aria-label={`${name} elsewhere`}>
      <a href={hex}><Package size={15} />Hex</a>
      <a href={hexdocs}><BookOpen size={15} />HexDocs</a>
      <a href={github}><Icon name="github" size="15px" />GitHub</a>
    </nav>
  </div>
</div>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('.pkg [data-copy]')) {
    b.addEventListener('click', async () => {
      await navigator.clipboard.writeText(b.dataset.copy!);
      const label = b.querySelector('[data-label]')!;
      label.textContent = 'Copied';
      setTimeout(() => (label.textContent = 'Copy'), 1500);
    });
  }
</script>

<style>
  .pkg { display: flex; flex-direction: column; gap: 1rem; margin-top: 1.25rem; }
  .facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .facts li {
    display: inline-flex; align-items: center; gap: 0.45rem; height: 1.85rem; padding: 0 0.75rem; border-radius: 999px;
    font-size: var(--sl-text-sm); color: var(--sl-color-gray-2);
    background: var(--sl-color-gray-6); border: 1px solid var(--sl-color-gray-5);
  }
  .facts :global(svg) { color: var(--sl-color-accent-high); flex: none; }
  .facts li:first-child span { font-family: var(--sl-font-mono); font-size: 0.85em; color: var(--sl-color-white); }

  .row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1.25rem; }
  .dep {
    display: inline-flex; align-items: center; gap: 0.9rem; height: 2.6rem; padding: 0 0.5rem 0 1rem; border-radius: 0.75rem; cursor: pointer;
    background: var(--sl-color-black); border: 1px solid var(--sl-color-gray-5); color: var(--sl-color-white); font: inherit;
    transition: border-color 0.2s;
  }
  .dep:hover { border-color: var(--sl-color-gray-4); }
  .dep code { font: 0.875rem var(--sl-font-mono); background: none; padding: 0; }
  .copy {
    display: inline-flex; align-items: center; gap: 0.35rem; height: 1.8rem; padding: 0 0.6rem; border-radius: 0.5rem;
    font-size: var(--sl-text-xs); color: var(--sl-color-gray-2); background: var(--sl-color-gray-6);
  }
  .links { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .links a {
    display: inline-flex; align-items: center; gap: 0.4rem; height: 2.2rem; padding: 0 0.7rem; border-radius: 0.6rem;
    font-size: var(--sl-text-sm); color: var(--sl-color-gray-2); text-decoration: none; transition: background 0.2s, color 0.2s;
  }
  .links a:hover { background: var(--sl-color-gray-6); color: var(--sl-color-white); }
  .links :global(svg) { color: var(--sl-color-accent-high); }
</style>
